{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!dist", "!.cache", "!.claude"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["ColorInput"] }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**"],
                "message": "Import from @/ instead of a parent directory."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["api/**"],
      "linter": {
        "rules": { "style": { "noRestrictedImports": "off" } }
      }
    }
  ]
}
